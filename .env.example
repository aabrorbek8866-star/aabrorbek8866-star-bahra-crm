# ===== Bahra Building CRM — sozlamalar =====
# Lokal ishlab chiqish uchun: cp .env.example .env

# PostgreSQL. Neon'da: Dashboard → Connect → "Connection string"
DATABASE_URL=postgres://bahra:bahra@localhost:5432/bahra_crm
# Neon / bulutdagi baza uchun "true"
DATABASE_SSL=false

# Sessiya imzosi — kamida 32 ta tasodifiy belgi (Render o'zi yaratadi)
JWT_SECRET=
SESSION_HOURS=12

# Birinchi ishga tushirishda yaratiladigan rahbar hisobi (keyin parolni tizim ichida o'zgartirish mumkin)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# AI agentlar (ixtiyoriy). Kalitsiz tizim ishlaydi, faqat AI chat javob bermaydi.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Eskiz.uz SMS (ixtiyoriy). Bo'sh bo'lsa SMS "DRY-RUN": yuborilmaydi, faqat jurnalga yoziladi.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

PORT=4000
